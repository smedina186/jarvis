FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 JARVIS_ENV=production
WORKDIR /app
COPY requirements-private.txt .
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; \
    pip install --no-cache-dir --require-hashes -r requirements-private.txt \
    && useradd --create-home --uid 10001 jarvis
COPY --chown=jarvis:jarvis config.py private_access.py private_main.py ./
USER jarvis
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn private_main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
