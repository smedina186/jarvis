{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "node ../scripts/netlify-preflight.mjs && next build",
    "test:hosting": "node --test ../scripts/netlify-preflight.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=iphone-layout --project=ipad-layout",
    "test:safari": "playwright test --project=iphone-webkit --project=ipad-webkit"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "convex": "^1.51.0",
    "framer-motion": "^12.34.3",
    "jose": "^6.2.18",
    "lucide-react": "^0.575.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
