# Convex deployment URL — get this from `npx convex dev` or your Convex dashboard.
# When unset, the app shows demo data only.
NEXT_PUBLIC_CONVEX_URL=

# Backend API URL — the FastAPI server address.
# Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=

# Server-only private access. Never prefix secrets with NEXT_PUBLIC_.
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Immutable numeric GitHub account ID, not username/email.
JARVIS_OWNER_GITHUB_ID=
JARVIS_BACKEND_URL=http://127.0.0.1:8000
# At least 32 random bytes; different from AUTH_SECRET. Same value in FastAPI.
JARVIS_BACKEND_AUTH_SECRET=
